{
  "name": "react-mongol",
  "version": "0.2.0",
  "description": "Show Cyrillic Mongolian websites in traditional script (Mongol bichig) with one toggle; React primitives for vertical layout, mixed-script orientation and Unicode-correct text.",
  "keywords": [
    "react",
    "mongolian",
    "mongol-bichig",
    "traditional-mongolian",
    "vertical-text",
    "writing-mode",
    "unicode",
    "i18n",
    "mvs",
    "fvs",
    "cyrillic",
    "transliteration"
  ],
  "license": "(MIT AND CC-BY-SA-4.0)",
  "author": "Altangerel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AltangerelG/react-mongol.git"
  },
  "bugs": {
    "url": "https://github.com/AltangerelG/react-mongol/issues"
  },
  "homepage": "https://github.com/AltangerelG/react-mongol#readme",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "bin",
    "dictionary/tools/review",
    "dictionary/tools/drafts-lib.mjs",
    "dictionary/LICENSE",
    "dictionary/NOTICE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "review": "node dictionary/tools/review/server.mjs",
    "dictionary": "node dictionary/tools/build-dictionary.mjs",
    "extension": "npm run dictionary && node extension/build.mjs"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@fontsource/noto-sans-mongolian": "^5.3.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@gege-mn/mongol-bichig": "^0.2.2",
    "khudam": "^0.2.0"
  },
  "bin": {
    "react-mongol": "bin/react-mongol.mjs"
  },
  "unpkg": "dist/mongol.global.js",
  "jsdelivr": "dist/mongol.global.js"
}
